# SmartLine Guardian Dashboard — Environment Config
# Copy this to .env.local and set your ESP32's actual IP address

# The IP address assigned to your ESP32 on your WiFi network.
# You will see it printed in the Serial Monitor after the ESP32 boots:
#   WiFi connected!
#   IP address: 192.168.X.XXX
VITE_ESP32_IP=192.168.1.100
